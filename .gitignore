# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*

# Next.js build output
/.next/
/out/
/build

# Vercel: the local project link, pulled environment files and build output
# must never be committed (they contain project and organisation identifiers,
# and pulled environment variables can contain secrets).
.vercel

# Environment files. Secrets must never be committed.
# Only a documented template such as .env.example may be tracked.
.env
.env.*
*.env
!.env.example

# Generated by Next.js / TypeScript
next-env.d.ts
*.tsbuildinfo

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# Test and verification output
/coverage
/playwright-report
/test-results

# Operating system and editor files
.DS_Store
Thumbs.db
*.pem
.idea/
*.swp
.vscode/*
!.vscode/extensions.json

# Python bytecode (the old build scripts were Python)
__pycache__/
*.pyc

